{
  "name": "finely",
  "version": "1.0.0",
  "description": "A SaaS app for businesses to track expenses, follow cash flow and turn financial data into insights.",
  "author": "Cihan Işık (https://www.linkedin.com/in/cihan-i%C5%9F%C4%B1k-1490b33a7)",
  "homepage": "https://finely-lemon.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/cihan286/finely.git"
  },
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:db": "docker run --rm -d --name finely-e2e-db -e POSTGRES_USER=e2e -e POSTGRES_PASSWORD=e2e -e POSTGRES_DB=finely_e2e -p 5433:5432 postgres:17",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.8.0",
    "better-auth": "^1.7.10",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "resend": "^6.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
