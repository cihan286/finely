# Copy this file to .env.local and fill in the values.

# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL=

# Better Auth: generate a secret with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; the Google button is hidden until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails via Resend (resend.com). Without an API key, emails are printed in
# the terminal instead. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Finely <noreply@yourdomain.com>"
# Where messages from the Contact page are sent (your own inbox)
CONTACT_EMAIL=
# Protects the scheduled jobs (/api/cron/weekly-digest and
# /api/cron/bank-sync): any long random
# text. Set the same value in Vercel, which then sends it with each run.
# Without it the job refuses to run.
CRON_SECRET=

# File storage for attached receipts and invoices: Vercel Blob (optional).
# Create a store in Vercel (Storage → Blob, with private access) and copy
# its read-write token. Without it, files are kept in the database. After
# setting it on a site that already has files, run `npm run files:move`
# once to move them.
BLOB_READ_WRITE_TOKEN=

# Linking banks via Plaid (plaid.com, optional; "Connect a bank" is hidden
# until all three of the first values are set). Keys are in the Plaid
# dashboard → Developers → Keys. PLAID_ENV is "sandbox" (pretend banks, for
# trying it out) or "production".
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Encrypts the banks' keys in the database: a long random text, made like
# BETTER_AUTH_SECRET. Keep it safe and never change it: with another value,
# every linked bank has to be linked again.
BANK_ENCRYPTION_KEY=

# Paid plans via Stripe (stripe.com, optional). Until all six are set,
# nothing can be bought and no plan limit is enforced. The secret key is in
# the Stripe dashboard → Developers → API keys; the webhook secret appears
# when you add the endpoint https://<your domain>/api/stripe/webhook
# (Developers → Webhooks) for the events customer.subscription.created,
# .updated and .deleted. The prices are the IDs (price_…) of the four
# recurring prices you create under Product catalog.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=

# Error monitoring via Sentry (sentry.io, optional). Without a DSN nothing is
# sent. The DSN is in Sentry → Project settings → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed where production builds run (Vercel), to upload source maps
# so Sentry shows readable stack traces. Create a token in Sentry →
# Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
