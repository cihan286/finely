# Copy this file to .env.local and fill in the values.

# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL=

# Better Auth: generate a secret with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; the Google button is hidden until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails via Resend (resend.com). Without an API key, emails are printed in
# the terminal instead. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Finely <noreply@yourdomain.com>"

# Error monitoring via Sentry (sentry.io, optional). Without a DSN nothing is
# sent. The DSN is in Sentry → Project settings → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed where production builds run (Vercel), to upload source maps
# so Sentry shows readable stack traces. Create a token in Sentry →
# Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
